# Ignore all files by default
*
!.gitignore

# include files explicitly by including them using patterns
!alacritty/
!alacritty/alacritty.toml

# fish config: track everything except runtime state, secrets, and generated files.
# New hand-written fish files are picked up automatically.
!fish/
!fish/**

# Runtime state / secrets
fish/fish_variables
fish/**/.DS_Store
fish/secure/**/*.json
fish/secure/**/*.txt

# Fisher-managed plugins (restored by bootstrap from fish_plugins).
# The authoritative list is generated from fisher's manifest into the managed
# block at the end of this file by scripts/sync-fisher-ignores.fish; these
# globs are a backstop. Private helpers are prefixed with the plugin name;
# public commands keep the command filename so Fish can autoload them.
fish/functions/_fzf_*.fish
fish/functions/fzf_configure_bindings.fish
fish/functions/_pwstore_*.fish
fish/functions/__pwstore_*.fish
fish/functions/pw.fish
fish/functions/_secret_*.fish
fish/functions/__secret_*.fish
fish/functions/__secretstore_*.fish
fish/functions/secret.fish
fish/functions/_filecrypt_*.fish
fish/functions/__filecrypt_*.fish
fish/functions/filecrypt.fish
fish/completions/fzf_configure_bindings.fish
fish/completions/pw.fish
fish/completions/secret.fish
fish/completions/filecrypt.fish
fish/conf.d/fzf.fish
fish/conf.d/pwstore.fish
fish/conf.d/secret.fish
fish/conf.d/filecrypt.fish

# Generated locally / by third-party tools
fish/conf.d/fish_frozen_key_bindings.fish
fish/conf.d/rustup.fish
fish/conf.d/terax.fish
fish/completions/bun.fish
fish/completions/docker.fish

# Custom scripts and scheduled jobs
!scripts/
!scripts/*.fish
!scripts/git-hooks/
!scripts/git-hooks/*
scripts/*.log
scripts/crontab.backup.*


!helix/
!karabiner/
!karabiner/assets/
!karabiner/assets/complex_modifications/
!karabiner/assets/complex_modifications/1746210900.json
!karabiner/karabiner.json
!nnn/
!nnn/bookmarks/
!nnn/mounts/
!nnn/plugins/
!nnn/sessions/
!nvim/
!nvim/LICENSE
!nvim/README.md
!nvim/init.lua
!nvim/lazy-lock.json
!nvim/lazyvim.json
!nvim/lua/
!nvim/lua/config/
!nvim/lua/config/*.lua
!nvim/lua/plugins/
!nvim/lua/plugins/*.lua

!nvim/queries/
!nvim/queries/*/
!nvim/queries/*/*.scm

!nvim/stylua.toml
!nvim/.neoconf.json
!zellij/
!zellij/config.kdl
!bootstrap-config.sh
!bootstrap.fish
!README.md

!brew/
!brew/brew-packages

# >>> fisher plugin files (managed by scripts/sync-fisher-ignores.fish)
# Generated from fisher universal variables. Do not edit by hand.
fish/completions/filecrypt.fish
fish/completions/fzf_configure_bindings.fish
fish/completions/pw.fish
fish/completions/secret.fish
fish/conf.d/filecrypt.fish
fish/conf.d/fzf.fish
fish/conf.d/pwstore.fish
fish/conf.d/secret.fish
fish/functions/_fzf_configure_bindings_help.fish
fish/functions/_fzf_extract_var_info.fish
fish/functions/_fzf_preview_changed_file.fish
fish/functions/_fzf_preview_file.fish
fish/functions/_fzf_report_diff_type.fish
fish/functions/_fzf_report_file_type.fish
fish/functions/_fzf_search_directory.fish
fish/functions/_fzf_search_git_log.fish
fish/functions/_fzf_search_git_status.fish
fish/functions/_fzf_search_history.fish
fish/functions/_fzf_search_processes.fish
fish/functions/_fzf_search_variables.fish
fish/functions/_fzf_wrapper.fish
fish/functions/_secret_add.fish
fish/functions/_secret_complete.fish
fish/functions/_secret_config.fish
fish/functions/_secret_delete.fish
fish/functions/_secret_edit.fish
fish/functions/_secret_export.fish
fish/functions/_secret_get.fish
fish/functions/_secret_get_gpg_recipient.fish
fish/functions/_secret_help.fish
fish/functions/_secret_list.fish
fish/functions/_secret_load.fish
fish/functions/filecrypt.fish
fish/functions/fzf_configure_bindings.fish
fish/functions/pw.fish
fish/functions/secret.fish
# <<< fisher plugin files
